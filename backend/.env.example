# Copy this file to ".env" and adjust values as needed.

# MongoDB connection string.
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/smartshelf

# If using MongoDB Atlas (cloud), it looks like:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smartshelf

# Port the Express server listens on
PORT=5000

# Set to "false" to disable automatic sample data on first run
LOAD_SAMPLE_DATA=false

# Email notifications (Gmail SMTP app password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-sender@gmail.com
